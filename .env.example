# Reference for the variables Cortex reads. The app does NOT auto-load a .env
# file — export these in your shell (or set them in your process manager / Docker
# `-e` flags). Only CORTEX_TOKEN is strictly required; every write is rejected
# until it is set.

# Shared secret for all write requests (POST/PATCH/DELETE). Use a long random
# string. The server, the hooks, and the MCP client all read the same value.
CORTEX_TOKEN=change-me-to-a-long-random-string

# Where the SQLite database lives. Default: ~/.cortex/cortex.sqlite
# CORTEX_DB=/absolute/path/to/cortex.sqlite

# Web server bind address and port. Loopback-only by default.
# CORTEX_HOST=127.0.0.1
# CORTEX_PORT=4317

# Comma-separated absolute paths that an autonomous agent must NEVER run against
# (e.g. a production or money-moving repo). Empty by default.
# CORTEX_NEVER_AUTOPILOT=/path/to/protected-repo,/path/to/another

# --- Advanced tuning (sensible defaults; leave unset unless you need them) ---
# Retention, token budgets, dedup thresholds, agent timeouts, and distillation
# intervals are all overridable via CORTEX_* variables. See the constants in
# src/ (grep for "process.env.CORTEX_") for the full list.
